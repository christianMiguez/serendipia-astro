---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import MailchimpForm from '~/components/widgets/MailchimpForm.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;

type LeadFormConfig = {
  u: string;
  id: string;
  fId: string;
  tags: number;
  title: string;
  description?: string;
};

const LEAD_FORMS: Record<string, LeadFormConfig> = {
  yoga: {
    u: 'd8e9fa69f115dd80f19ef36e0',
    id: 'b574becbb8',
    fId: '0056aee6f0',
    tags: 3022061,
    title: 'Me interesa',
    description: 'Te avisamos cuando abramos la próxima inscripción a las clases de yoga.',
  },
  'constelaciones-familiares': {
    u: 'd8e9fa69f115dd80f19ef36e0',
    id: 'b574becbb8',
    fId: '0055aee6f0',
    tags: 3022062,
    title: 'ME INTERESA',
    description: 'Te avisamos cuando anunciemos la próxima edición de Constelaciones Familiares.',
  },
};

const leadForm = LEAD_FORMS[post.id] ?? null;
const hasLeadForm = !!leadForm;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article
    class:list={[
      hasLeadForm && 'max-w-6xl mx-auto lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-10 lg:items-start',
    ]}
  >
    <header
      class:list={[
        post.image
          ? 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          : 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
        hasLeadForm && 'lg:col-start-1 lg:row-start-1',
      ]}
    >
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 text-muted" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 text-muted" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted text-justify">
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-lg bg-cream"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t border-border" />
          </div>
        )
      }
    </header>

    {
      hasLeadForm && leadForm && (
        <aside class="px-4 sm:px-6 lg:px-0 lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:self-start lg:sticky lg:top-24">
          <MailchimpForm {...leadForm} />
        </aside>
      )
    }

    <div
      class:list={[
        'mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-xl prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-headings:text-text-heading prose-a:text-primary-strong prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg prose-img:shadow-md mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0',
        hasLeadForm && 'lg:col-start-1 lg:row-start-2',
      ]}
    >
      <slot />
    </div>
    <div
      class:list={[
        'mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row',
        hasLeadForm && 'lg:col-start-1 lg:row-start-3',
      ]}
    >
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-muted" />
    </div>
  </article>
</section>
