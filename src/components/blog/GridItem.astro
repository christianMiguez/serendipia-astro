---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="mb-6 bg-surface rounded-xl shadow-sm p-6 md:p-7 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade hover:shadow-md hover:scale-105 after:absolute after:inset-x-0 after:bottom-0 after:h-[5px] after:content-[''] after:bg-gradient-to-r after:from-logo-blue after:via-logo-teal after:to-logo-green"
>
  <div class="relative md:h-64 bg-cream rounded-lg mb-6">
    {
      image &&
        (link ? (
          <a href={link}>
            <Image
              src={image}
              class="w-full md:h-full object-cover rounded-lg bg-cream"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="w-full md:h-full object-cover rounded-lg bg-cream"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ))
    }
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading text-text-heading">
    {
      link ? (
        <a class="inline-block hover:text-primary-strong transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-muted text-lg">{post.excerpt}</p>
</article>
