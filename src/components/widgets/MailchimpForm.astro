---
export interface Props {
  u: string;
  id: string;
  fId: string;
  tags: number;
  title: string;
  buttonText?: string;
  description?: string;
  keepBadge?: boolean;
}

const { u, id, fId, tags, title, buttonText = 'Quiero que me avisen', description, keepBadge = true } = Astro.props;

const action = `https://serendipia.us18.list-manage.com/subscribe/post?u=${u}&id=${id}&f_id=${fId}`;
const honeypotName = `b_${u}_${id}`;
const inputClass =
  'py-2.5 px-3 block w-full text-sm rounded-lg border border-border bg-surface text-page placeholder:text-muted shadow-sm transition focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent';
const labelClass = 'block text-sm font-medium text-text-heading mb-1';
---

<div>
  <section class="rounded-lg border border-border bg-surface shadow p-5 sm:p-6">
    <h2 class="font-heading font-bold text-xl text-text-heading mb-3">{title}</h2>

    <form
      action={action}
      method="post"
      id="mc-embedded-subscribe-form"
      name="mc-embedded-subscribe-form"
      class="validate"
      target="_self"
      novalidate
    >
      <div id="mc_embed_signup_scroll">
        <div class="indicates-required mb-3 text-xs text-muted">
          <span class="asterisk text-error">*</span> campos obligatorios
        </div>

        <div class="mc-field-group mb-4">
          <label for="mce-EMAIL" class={labelClass}>
            Tu correo electrónico <span class="asterisk text-error">*</span>
          </label>
          <input
            type="email"
            name="EMAIL"
            class={`required email ${inputClass}`}
            id="mce-EMAIL"
            required
            value=""
            autocomplete="email"
          />
        </div>

        <div class="mc-field-group mb-4">
          <label for="mce-FNAME" class={labelClass}>Tu nombre de pila</label>
          <input
            type="text"
            name="FNAME"
            class={`text ${inputClass}`}
            id="mce-FNAME"
            value=""
            autocomplete="given-name"
          />
        </div>

        <div hidden>
          <input type="hidden" name="tags" value={tags} />
        </div>

        <div id="mce-responses" class="clear foot">
          <div class="response" id="mce-error-response" style="display:none;"></div>
          <div class="response" id="mce-success-response" style="display:none;"></div>
        </div>

        <div aria-hidden="true" style="position: absolute; left: -5000px;">
          <input type="text" name={honeypotName} tabindex="-1" value="" />
        </div>

        <div class="optionalParent">
          <div class="clear foot">
            <div class="grid">
              <button type="submit" name="subscribe" id="mc-embedded-subscribe" class="btn btn-primary">
                {buttonText}
              </button>
            </div>
            {
              keepBadge && (
                <p style="margin: 0px auto;">
                  <a href="http://eepurl.com/iPbA7s" title="Mailchimp - email marketing made easy and fun">
                    <span style="display: inline-block; background-color: transparent; border-radius: 4px;">
                      <img
                        class="refferal_badge"
                        src="https://digitalasset.intuit.com/render/content/dam/intuit/mc-fe/en_us/images/intuit-mc-rewards-text-dark.svg"
                        alt="Intuit Mailchimp"
                        style="width: 220px; height: 40px; display: flex; padding: 2px 0px; justify-content: center; align-items: center;"
                      />
                    </span>
                  </a>
                </p>
              )
            }
          </div>
        </div>

        {description && <p class="mt-3 text-center text-xs text-muted">{description}</p>}
      </div>
    </form>
  </section>
</div>

<script is:inline src="https://s3.amazonaws.com/downloads/mailchimp.com/js/mc-validate.js"></script>
<script is:inline>
  (function (w) {
    w['fnames'] = ['EMAIL', 'FNAME'];
    w['ftypes'] = ['email', 'text'];
  })(window);
  window.$mcj = jQuery.noConflict(true);
</script>
