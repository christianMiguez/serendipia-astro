---
import { SITE } from 'astrowind:config';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
>
  <svg version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 73" width="64" height="64" class="inline-block">
    <defs>
      <image
        width="74"
        height="71"
        id="img1"
        href="data:image/png;base64,"
      />
    </defs>
    <style></style>
    <use id="Background" href="#img1" x="3" y="1"></use>
  </svg>
  {SITE?.name}
</span>
