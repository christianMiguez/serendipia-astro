---
import '@fontsource-variable/nunito';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Nunito Variable';
    --aw-font-serif: 'Nunito Variable';
    --aw-font-heading: 'Nunito Variable';

    --aw-color-primary: rgb(77 164 129);
    --aw-color-primary-strong: rgb(60 140 110);

    --aw-color-secondary: rgb(208 226 204);
    --aw-color-secondary-strong: rgb(180 205 174);

    --aw-color-accent: rgb(188 217 232);

    --aw-color-logo-blue: rgb(74 144 196);
    --aw-color-logo-teal: rgb(90 178 170);
    --aw-color-logo-green: rgb(46 158 90);

    --aw-color-surface: rgb(255 252 247);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-border: rgb(235 229 220);

    --aw-color-text-heading: rgb(58 52 48);
    --aw-color-text-default: rgb(58 52 48);
    --aw-color-text-muted: rgb(120 114 108);
    --aw-color-text-page: rgb(58 52 48);

    --aw-color-success: rgb(170 203 170);
    --aw-color-warning: rgb(243 221 170);
    --aw-color-error: rgb(236 178 170);

    --aw-color-salmon-soft: rgb(250 226 219);
    --aw-color-sage-soft: rgb(224 236 220);
    --aw-color-celeste-soft: rgb(220 236 245);
    --aw-color-blush: rgb(245 216 210);
    --aw-color-lavender: rgb(216 200 239);
    --aw-color-cream: rgb(252 247 240);
    --aw-color-beige-soft: rgb(244 236 226);

    ::selection {
      background-color: rgb(188 217 232);
      color: rgb(58 52 48);
    }
  }
</style>
