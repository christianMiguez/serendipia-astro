---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';
import { SITE, METADATA } from 'astrowind:config';
import { floresDeBach as fdbData } from '~/data/flores-de-bach';

export const prerender = true;

const postsRaw = await getCollection('post');
const posts = postsRaw
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const da = a.data.publishDate ? a.data.publishDate.getTime() : 0;
    const db = b.data.publishDate ? b.data.publishDate.getTime() : 0;
    return db - da;
  });

const cleanTitle = (title: string) => title.split(/\s+\|\s+/)[0].trim();

const reservarUrl =
  'https://wa.me/59899419419?text=Hola%2C+quisiera+consultar+por+el+alquiler+de+un+consultorio+en+Espacio+Serendipia.+%C2%BFMe+podr%C3%ADan+brindar+m%C3%A1s+informaci%C3%B3n%3F&utm_source=chatgpt.com';

const features = [
  {
    icon: 'tabler:brain',
    bg: 'bg-celeste-soft',
    tint: 'text-accent',
    title: 'Terapia psicológica',
    text: 'Acompañamiento profesional.',
  },
  {
    icon: 'tabler:home',
    bg: 'bg-salmon-soft',
    tint: 'text-primary-strong',
    title: 'Alquiler de consultorios',
    text: 'Reserva desde la App por hora.',
  },
  {
    icon: 'tabler:flower',
    bg: 'bg-sage-soft',
    tint: 'text-secondary-strong',
    title: 'Terapias alternativas',
    text: 'Flores de bach, Constelaciones y más',
  },
];

const metadata = {
  title: `${SITE.name} — Espacio de bienestar en Villa del Cerro`,
  ignoreTitleTemplate: true,
  description: METADATA?.description,
};
---

<Layout metadata={metadata}>
  <section class="relative md:-mt-[95px] overflow-hidden bg-page not-prose">
    <img
      src="/bg.webp"
      alt="Interior de nuestro espacio de bienestar en el Cerro de Montevideo"
      class="absolute inset-y-0 right-0 h-full w-full object-cover hidden md:block md:w-[80%]"
    />
    <div
      class="absolute inset-0 md:bg-gradient-to-r md:from-white md:via-white/85 md:via-40% md:to-transparent md:to-80%"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="pt-0 md:pt-[76px]" aria-hidden="true"></div>
      <div class="py-12 md:py-20">
        <div class="max-w-2xl">
          <h1 class="text-3xl md:text-4xl font-bold font-heading text-text-heading leading-tight mb-6">
            Espacio de bienestar Integral
          </h1>
          <p class="text-muted leading-relaxed md:max-w-lg mb-8">
            En el Cerro de Montevideo, te acompañamos con <strong>terapia psicológica</strong> y terapias alternativas para
            tu bienestar integral. También alquilamos <strong>consultorios por hora</strong> para profesionales de la salud.
          </p>

          <div class="flex flex-wrap items-center gap-4 mb-12">
            <Button variant="primary" href="#servicios" text="VER SERVICIOS" />
            <Button
              variant="secondary"
              href={reservarUrl}
              target="_blank"
              text="RESERVAR CONSULTORIO"
              icon="tabler:arrow-right"
            />
          </div>

          <ul class="grid gap-6 sm:grid-cols-3 sm:gap-4">
            {
              features.map((feature) => (
                <li class="flex items-start gap-3">
                  <span
                    class:list={[
                      'flex-none w-12 h-12 rounded-full flex items-center justify-center',
                      feature.bg,
                      feature.tint,
                    ]}
                  >
                    <Icon name={feature.icon} class="w-6 h-6" />
                  </span>
                  <span>
                    <span class="block font-bold font-heading text-text-heading text-sm md:text-base">
                      {feature.title}
                    </span>
                    <span class="block text-xs md:text-sm text-muted leading-snug">{feature.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Teaser: Flores de Bach *********************************** -->
  <section class="px-4 sm:px-6 py-12 md:py-20">
    <div class="max-w-7xl mx-auto">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-sage-soft via-bg-page to-celeste-soft ring-1 ring-border shadow-sm"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center p-8 sm:p-10 md:p-14">
          <div
            class="intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade-up-blur"
          >
            <span
              class="inline-flex items-center gap-2 rounded-full bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary-strong shadow-sm"
            >
              <Icon name="tabler:flower" class="w-3.5 h-3.5" />
              {fdbData.card.category}
            </span>
            <h2 class="mt-4 text-3xl font-bold font-heading text-text-heading leading-tight sm:text-4xl">
              Flores de Bach en el Cerro de Montevideo
            </h2>
            <p class="mt-4 text-muted leading-relaxed text-lg">
              {fdbData.card.excerpt}
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <Button variant="primary" text="VER MÁS" href={fdbData.card.href} icon="tabler:arrow-right" />
              <Button variant="secondary" text="AGENDAR SESIÓN" href={fdbData.whatsappHref} target="_blank" />
            </div>
          </div>
          <div
            class="intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade-up-blur"
          >
            <figure class="overflow-hidden rounded-2xl shadow-xl ring-1 ring-border">
              <img
                src={fdbData.card.image}
                alt="Flores suaves color pastel en un campo luminoso"
                class="aspect-[5/4] w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="servicios" class="px-4 sm:px-6 py-6 md:py-10">
    <div class="max-w-7xl mx-auto">
      <h3 class="text-2xl font-bold font-heading text-text-heading leading-tight mb-6 text-center">
        ✨ Todo lo que tenemos para vos
      </h3>
      <p class="text-muted leading-relaxed text-center mb-8">
        Descubrí nuestras terapias, servicios y actividades para crecer, sanar y compartir.
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {
          posts.map((post) => {
            const link = getPermalink(post.id, 'post');
            const title = cleanTitle(post.data.title);
            const category = post.data.category || 'Servicios';
            return (
              <li>
                <a
                  href={link}
                  class={`relative block h-full bg-surface rounded-xl shadow-sm p-6 md:p-7 hover:shadow-md hover:scale-105 transition duration-200 ease-in overflow-hidden after:absolute after:inset-x-0 after:bottom-0 after:h-[5px] after:content-[''] after:bg-gradient-to-r after:from-warning after:via-salmon-soft after:to-error`}
                >
                  <span
                    class={`inline-block text-xs font-semibold uppercase tracking-wide rounded-full px-3 py-1 mb-4 bg-sage-soft text-primary-strong`}
                  >
                    {category}
                  </span>
                  <h2 class="text-lg font-bold font-heading text-text-heading leading-snug mb-3">{title}</h2>
                  {post.data.excerpt && <p class="text-sm text-muted leading-relaxed">{post.data.excerpt}</p>}
                  <span class="mt-5 inline-flex items-center text-primary-strong font-semibold text-sm group-hover:text-text-heading transition">
                    Conocé más
                    <span class="ml-1" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Layout>
