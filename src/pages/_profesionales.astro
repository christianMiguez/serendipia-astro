---
import { Icon } from 'astro-icon/components';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const reservarUrl =
  'https://wa.me/59899419419?text=Hola%2C+quisiera+reservar+una+sesi%C3%B3n+con+un+profesional+en+Espacio+Serendipia.%C2%BFMe+podr%C3%ADan+orientar%3F&utm_source=chatgpt.com';

interface Profesional {
  name: string;
  job: string;
  bio: string;
  image: { src: string; alt: string };
  servicioHref?: string;
}

const profesionales: Profesional[] = [
  {
    name: 'Lic. Carolina Pérez',
    job: 'Psicóloga · Salud Mental',
    bio: 'Acompaña a adultas y adultos y a parejas en procesos de angustia, vínculo y autoconocimiento.',
    image: {
      src: 'https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Carolina Pérez',
    },
    servicioHref: getPermalink('psicologia', 'post'),
  },
  {
    name: 'María Fernanda Sosa',
    job: 'Terapeuta Floral · Área Holística',
    bio: 'Sesiones de Flores de Bach y acompañamiento orientado al bienestar emocional y al autoconocimiento.',
    image: {
      src: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de María Fernanda Sosa',
    },
    servicioHref: getPermalink('flores-de-bach', 'post'),
  },
  {
    name: 'Daniela Ríos',
    job: 'Profesora de Yoga y AeroYoga',
    bio: 'Clases de Hatha Yoga y AeroYoga para todas las edades y niveles, con foco en el cuerpo y la respiración.',
    image: {
      src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Daniela Ríos',
    },
    servicioHref: getPermalink('yoga', 'post'),
  },
  {
    name: 'Martín Olivera',
    job: 'Quiropráctico · Área Holística',
    bio: 'Sesiones de quiropraxia para mejorar la movilidad, soltar tensiones y recuperar el equilibrio del cuerpo.',
    image: {
      src: 'https://images.unsplash.com/photo-1612349317150-e7cef7c9c835?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Martín Olivera',
    },
    servicioHref: getPermalink('quiropraxia', 'post'),
  },
  {
    name: 'Dra. Liu Wen',
    job: 'Acupunturista · Área Holística',
    bio: 'Acupuntura basada en la Medicina Tradicional China para promover el equilibrio y el bienestar integral.',
    image: {
      src: 'https://images.unsplash.com/photo-1622253692010-333f2da6055d?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Liu Wen',
    },
    servicioHref: getPermalink('acupuntura', 'post'),
  },
  {
    name: 'Sofía Martínez',
    job: 'Profesora de Pilates',
    bio: 'Pilates adaptado a cada cuerpo para mejorar la postura, la fuerza y la conciencia corporal.',
    image: {
      src: 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Sofía Martínez',
    },
    servicioHref: getPermalink('pilates', 'post'),
  },
  {
    name: 'Graciela Romero',
    job: 'Consteladora Familiar',
    bio: 'Constelaciones Familiares para comprender vínculos y mirar de otra forma la historia de tu sistema.',
    image: {
      src: 'https://images.unsplash.com/photo-1488161628813-04466f872be2?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Graciela Romero',
    },
    servicioHref: getPermalink('constelaciones-familiares', 'post'),
  },
  {
    name: 'Ezequiel Liu',
    job: 'Tarotista · Talleres',
    bio: 'Talleres y sesiones de tarot terapéutico para reflexionar y acompañar procesos de vida.',
    image: {
      src: 'https://images.unsplash.com/photo-1500648766831-d503f7b4bcc8?auto=format&fit=crop&w=400&q=80',
      alt: 'Foto de Ezequiel Liu',
    },
    servicioHref: getPermalink('tarot', 'post'),
  },
];

const metadata = {
  title: 'Profesionales',
  description:
    'Conocé al equipo de Espacio Serendipia: psicología, terapias holísticas y actividades, con profesionales habilitados que trabajan de manera independiente en el Cerro de Montevideo.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget **************** -->

  <HeroText
    tagline="Profesionales"
    title="Conocé a quienes te acompañan"
    subtitle="El equipo de Serendipia está formado por profesionales independientes que comparten una misma forma de cuidar y de acompañar. Cada uno trabaja en su disciplina y con su propio encuadre; vos elegís con quién reservar."
  />

  <!-- Grid de profesionales ********* -->

  <section class="px-4 sm:px-6 py-6 md:py-10">
    <div class="max-w-7xl mx-auto">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {
          profesionales.map((p) => (
            <li class="flex flex-col bg-surface rounded-xl shadow-sm overflow-hidden hover:shadow-md transition duration-200 ease-in">
              <Image
                class="w-full h-56 object-cover bg-gray-200"
                src={p.image.src}
                alt={p.image.alt}
                width={400}
                height={400}
                layout="fixed"
                format="webp"
              />
              <div class="p-5 flex flex-col grow">
                <h2 class="text-lg font-bold font-heading text-text-heading leading-snug">{p.name}</h2>
                <p class="text-sm text-primary-strong font-semibold mb-3">{p.job}</p>
                <p class="text-sm text-muted leading-relaxed grow">{p.bio}</p>
                {p.servicioHref && (
                  <a
                    href={p.servicioHref}
                    class="mt-4 inline-flex items-center text-primary-strong font-semibold text-sm hover:text-text-heading transition"
                  >
                    Ver el servicio
                    <Icon name="tabler:arrow-right" class="ml-1 w-4 h-4" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="text-xs text-muted text-center mt-6">
        Los nombres y fotos son ilustrativos hasta que nos confirmen los datos de cada profesional.
      </p>
    </div>
  </section>

  <!-- Features2 Widget ************** -->

  <Features2
    title="¿Cómo reservar con un profesional?"
    subtitle="Cada profesional coordina sus propios turnos. Te explicamos cómo llegar."
    columns={4}
    items={[
      {
        title: 'Elegí el servicio',
        description: 'Entrá a la página del servicio que te interesa y leés los detalles de la atención.',
        icon: 'tabler:search',
      },
      {
        title: 'Escribinos por WhatsApp',
        description: 'Te conectamos con el profesional o te damos sus datos para que reserves directo.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Coordiná día y hora',
        description: 'Acordás el primer encuentro, presencial o virtual, según la modalidad de cada uno.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Conocelos en persona',
        description: 'Llegás al espacio y tenés tu primera sesión con el profesional que elegiste.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="¿Querés reservar con un profesional?"
    subtitle="Escribinos por WhatsApp y te orientamos sobre el servicio y el profesional que mejor encaje con vos."
    actions={[
      {
        variant: 'primary',
        text: 'HABLAR POR WHATSAPP',
        href: reservarUrl,
        target: '_blank',
        icon: 'tabler:arrow-right',
      },
      { variant: 'tertiary', text: 'Ver servicios', href: getPermalink('/servicios') },
    ]}
  />
</Layout>
